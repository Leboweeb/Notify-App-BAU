            android:layout_columnWeight="1"
            android:layout_width="0dp"
            android:background="#EEEEEE"
            android:gravity="center"
            android:padding="4dp"
            android:text=""
            android:textColor="#000000"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
