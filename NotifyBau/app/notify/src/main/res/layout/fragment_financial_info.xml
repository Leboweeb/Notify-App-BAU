<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FinancialInfoFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/data_table"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.cardview.widget.CardView
                android:id="@+id/user_card"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="252dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">


                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/user_image"
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_person_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:riv_corner_radius="20dp" />

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="140dp"
                        android:fontFamily="@font/segoeui"
                        android:maxLines="5"
                        android:text="[User Name]"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/lbp_card"
                android:layout_width="234dp"
                android:layout_height="91dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:contentPadding="8dp"
                app:layout_constraintBottom_toTopOf="@+id/usd_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.994"
                app:layout_constraintStart_toEndOf="@id/user_card"
                app:layout_constraintTop_toTopOf="parent">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/lbp_photo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/baseline_person_24"
                    app:riv_corner_radius="20dp" />

                <TextView
                    android:id="@+id/lbp_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="75dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/segoeui"
                    android:text="LBP"
                    android:textSize="20sp">

                </TextView>

                <TextView
                    android:id="@+id/lbp_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="75dp"
                    android:layout_marginTop="45dp"
                    android:fontFamily="@font/segoeui"
                    android:text="[LBP Remaining]"
                    android:textSize="20sp"
                    app:layout_constraintStart_toEndOf="@id/def_user_photo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/usd_card"
                android:layout_width="234dp"
                android:layout_height="94dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="156dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:contentPadding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.9"
                app:layout_constraintStart_toEndOf="@+id/user_card"
                app:layout_constraintTop_toTopOf="parent">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/usd_photo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/baseline_person_24"
                    app:riv_corner_radius="20dp" />

                <TextView
                    android:id="@+id/usd_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="75dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/segoeui"
                    android:maxLines="3"
                    android:text="USD"
                    android:textSize="20sp">

                </TextView>

                <TextView
                    android:id="@+id/usd_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="75dp"
                    android:layout_marginTop="45dp"
                    android:fontFamily="@font/segoeui"
                    android:maxLines="5"
                    android:text="4296$"
                    android:textSize="20sp"
                    app:layout_constraintStart_toEndOf="@id/def_user_photo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <ir.androidexception.datatable.DataTable
            android:id="@+id/data_table"
            android:layout_width="397dp"
            android:layout_height="457dp"
            android:layout_margin="8dp"
            app:corner_radius="8dp"
            app:direction="ltr"
            app:header_background_color="#fff"
            app:header_gravity="center"
            app:header_horizontal_padding="0dp"
            app:header_text_color="#000"
            app:header_text_size="12sp"
            app:header_vertical_padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:persian_number="false"
            app:row_background_color="#fff"
            app:row_gravity="center"
            app:row_text_color="#000"
            app:row_text_size="12sp"
            app:row_vertical_padding="16dp"
            app:shadow="8dp"
            tools:ignore="MissingClass" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>